rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && (
          request.auth.token.email_verified == true
          || request.auth.token.firebase.sign_in_provider == 'google.com'
          || request.auth.token.firebase.sign_in_provider == 'anonymous'
        );
    }

    function isCurrentUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function authProviderName() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous'
        ? 'guest'
        : request.auth.token.firebase.sign_in_provider == 'google.com'
          ? 'google'
          : 'password';
    }

    function ownsExistingDocument() {
      return signedIn()
        && resource.data.userId is string
        && resource.data.userId == request.auth.uid;
    }

    function ownsIncomingDocument() {
      return signedIn()
        && request.resource.data.userId is string
        && request.resource.data.userId == request.auth.uid;
    }

    function isShortString(value, maximumLength) {
      return value is string && value.size() <= maximumLength;
    }

    function hasValidProfileImagePath(value, userId) {
      return isShortString(value, 512)
        && (
          value == ''
          || value.matches(
            '^users/' + userId
              + '/profile/[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-'
              + '[1-5][0-9A-Fa-f]{3}-[89AaBb][0-9A-Fa-f]{3}-'
              + '[0-9A-Fa-f]{12}[.](jpg|png|webp)$'
          )
        );
    }

    function isStringList(value, maximumItems) {
      return value is list && value.size() <= maximumItems;
    }

    function isIsoDate(value) {
      return value is timestamp
        || (
          value is string
          && value.matches(
            '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$'
          )
        );
    }

    function hasValidPrivacyPreferences(value) {
      return value is map
        && value.keys().hasOnly([
          'requirePrivateCheck',
          'showReflectionDates'
        ])
        && value.keys().hasAll([
          'requirePrivateCheck',
          'showReflectionDates'
        ])
        && value.requirePrivateCheck is bool
        && value.requirePrivateCheck == true
        && value.showReflectionDates is bool;
    }

    function hasValidUserShape(data) {
      return data.keys().hasOnly([
          'id',
          'email',
          'isGuest',
          'authProvider',
          'createdAt',
          'updatedAt',
          'privacyConsentAt',
          'spiritualIntroSeenAt',
          'profileCompleted',
          'privacyPreferences'
        ])
        && data.keys().hasAll([
          'id',
          'email',
          'createdAt',
          'updatedAt',
          'profileCompleted'
        ])
        && data.id is string
        && data.email is string
        && data.email.size() <= 320
        && (!('isGuest' in data) || data.isGuest is bool)
        && (!('authProvider' in data) || data.authProvider in ['password', 'google', 'guest'])
        && isIsoDate(data.createdAt)
        && isIsoDate(data.updatedAt)
        && data.profileCompleted is bool
        && (
          !('privacyConsentAt' in data)
          || data.privacyConsentAt == null
          || isIsoDate(data.privacyConsentAt)
        )
        && (
          !('spiritualIntroSeenAt' in data)
          || data.spiritualIntroSeenAt == null
          || isIsoDate(data.spiritualIntroSeenAt)
        )
        && (
          !('privacyPreferences' in data)
          || hasValidPrivacyPreferences(data.privacyPreferences)
        );
    }

    function hasValidProfileShape(data) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'profileName',
          'imagePath',
          'selectedSymbol',
          'spiritualBio',
          'spiritualGuides',
          'lifeDirections',
          'heartSeeks',
          'godsComment',
          'heavenlyHashtag',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'id',
          'userId',
          'profileName',
          'imagePath',
          'selectedSymbol',
          'spiritualBio',
          'spiritualGuides',
          'lifeDirections',
          'heartSeeks',
          'godsComment',
          'heavenlyHashtag',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.userId is string
        && isShortString(data.profileName, 60)
        && data.profileName.size() > 0
        && hasValidProfileImagePath(data.imagePath, data.userId)
        && data.selectedSymbol in [
          '',
          'candle',
          'seed',
          'cross',
          'heart',
          'open-hands',
          'road'
        ]
        && (data.imagePath == '' || data.selectedSymbol == '')
        && isShortString(data.spiritualBio, 320)
        && isStringList(data.spiritualGuides, 30)
        && isStringList(data.lifeDirections, 30)
        && isStringList(data.heartSeeks, 30)
        && isShortString(data.godsComment, 280)
        && isShortString(data.heavenlyHashtag, 40)
        && isIsoDate(data.createdAt)
        && isIsoDate(data.updatedAt);
    }

    function hasValidPrivateProfileShape(data) {
      return data.keys().hasOnly([
          'userId',
          'hiddenStory',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'userId',
          'hiddenStory',
          'updatedAt'
        ])
        && data.userId is string
        && isShortString(data.hiddenStory, 1000)
        && isIsoDate(data.updatedAt);
    }

    function hasValidProfileImageHistoryShape(data) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'imagePath',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'id',
          'userId',
          'imagePath',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.userId is string
        && hasValidProfileImagePath(data.imagePath, data.userId)
        && isIsoDate(data.createdAt)
        && isIsoDate(data.updatedAt);
    }

    function hasValidDraftData(value, userId) {
      return value is map
        && value.keys().hasOnly([
          'profileName',
          'imagePath',
          'selectedSymbol',
          'spiritualBio',
          'spiritualGuides',
          'lifeDirections',
          'onboardingPostTitles',
          'onboardingPosts',
          'heartSeeks',
          'hiddenStory',
          'godsComment',
          'heavenlyHashtag'
        ])
        && value.keys().hasAll([
          'profileName',
          'imagePath',
          'selectedSymbol',
          'spiritualBio',
          'spiritualGuides',
          'lifeDirections',
          'onboardingPosts',
          'heartSeeks',
          'hiddenStory',
          'godsComment',
          'heavenlyHashtag'
        ])
        && isShortString(value.profileName, 60)
        && hasValidProfileImagePath(value.imagePath, userId)
        && value.selectedSymbol in [
          '',
          'candle',
          'seed',
          'cross',
          'heart',
          'open-hands',
          'road'
        ]
        && (value.imagePath == '' || value.selectedSymbol == '')
        && isShortString(value.spiritualBio, 320)
        && isStringList(value.spiritualGuides, 30)
        && isStringList(value.lifeDirections, 30)
        && (
          !value.keys().hasAny(['onboardingPostTitles'])
          || isStringList(value.onboardingPostTitles, 20)
        )
        && isStringList(value.onboardingPosts, 20)
        && isStringList(value.heartSeeks, 30)
        && isShortString(value.hiddenStory, 1000)
        && isShortString(value.godsComment, 280)
        && isShortString(value.heavenlyHashtag, 40);
    }

    function hasValidDraftShape(data) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'currentStep',
          'draftData',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'id',
          'userId',
          'currentStep',
          'draftData',
          'updatedAt'
        ])
        && data.id is string
        && data.userId is string
        && data.currentStep is int
        && data.currentStep >= 0
        && data.currentStep <= 10
        && hasValidDraftData(data.draftData, data.userId)
        && isIsoDate(data.updatedAt);
    }

    function hasValidReflectionShape(data) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'title',
          'content',
          'isPrivate',
          'createdAt',
          'updatedAt',
          'editedAt'
        ])
        && data.keys().hasAll([
          'id',
          'userId',
          'title',
          'content',
          'isPrivate',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.userId is string
        && (!data.keys().hasAny(['title']) || isShortString(data.title, 60))
        && isShortString(data.content, 500)
        && data.content.size() > 0
        && data.isPrivate is bool
        && isIsoDate(data.createdAt)
        && isIsoDate(data.updatedAt)
        && (!('editedAt' in data) || isIsoDate(data.editedAt));
    }

    function hasValidSocialProfileShape(data) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'profileName',
          'imagePath',
          'spiritualBio',
          'heavenlyHashtag',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'id',
          'userId',
          'profileName',
          'imagePath',
          'spiritualBio',
          'heavenlyHashtag',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.userId is string
        && isShortString(data.profileName, 60)
        && data.profileName.size() > 0
        && hasValidProfileImagePath(data.imagePath, data.userId)
        && isShortString(data.spiritualBio, 320)
        && isShortString(data.heavenlyHashtag, 40)
        && isIsoDate(data.createdAt)
        && isIsoDate(data.updatedAt);
    }

    function hasValidFollowShape(data) {
      return data.keys().hasOnly([
          'id',
          'followerId',
          'followingId',
          'createdAt'
        ])
        && data.keys().hasAll([
          'id',
          'followerId',
          'followingId',
          'createdAt'
        ])
        && data.id is string
        && data.followerId is string
        && data.followingId is string
        && data.followerId != data.followingId
        && isIsoDate(data.createdAt);
    }

    function hasValidReflectionLikeShape(data) {
      return data.keys().hasOnly([
          'id',
          'reflectionId',
          'postOwnerId',
          'userId',
          'createdAt'
        ])
        && data.keys().hasAll([
          'id',
          'reflectionId',
          'postOwnerId',
          'userId',
          'createdAt'
        ])
        && data.id is string
        && data.reflectionId is string
        && data.postOwnerId is string
        && data.userId is string
        && data.postOwnerId != data.userId
        && isIsoDate(data.createdAt);
    }

    function hasValidReflectionCommentShape(data) {
      let hasParentComment =
        data.keys().hasAny([
          'parentCommentId'
        ]);

      let hasReplyTarget =
        data.keys().hasAny([
          'replyToUserId'
        ]);

      return data.keys().hasOnly([
          'id',
          'reflectionId',
          'postOwnerId',
          'userId',
          'parentCommentId',
          'replyToUserId',
          'content',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'id',
          'reflectionId',
          'postOwnerId',
          'userId',
          'content',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.reflectionId is string
        && data.postOwnerId is string
        && data.userId is string
        && data.content is string
        && data.content.size() > 0
        && data.content.size() <= 500
        && isIsoDate(data.createdAt)
        && isIsoDate(data.updatedAt)

        && (
          /*
          * NORMAL COMMENT
          */
          (
            !hasParentComment
            && !hasReplyTarget
            && data.postOwnerId
              != data.userId
          )

          ||

          /*
          * REPLY
          */
          (
            hasParentComment
            && hasReplyTarget
            && data.parentCommentId
              is string
            && data.parentCommentId
              .size() > 0
            && data.replyToUserId
              is string
            && data.replyToUserId
              .size() > 0
          )
        );
    }

    function isValidReplyTarget(data) {
      let parentPath =
        /databases/$(database)/documents/reflectionComments/$(data.parentCommentId);

      return exists(parentPath)

        /*
        * Parent must belong to the same
        * reflection.
        */
        && get(parentPath)
          .data.reflectionId
          == data.reflectionId

        /*
        * Parent must belong to the same
        * reflection owner.
        */
        && get(parentPath)
          .data.postOwnerId
          == data.postOwnerId

        /*
        * The user being replied to must
        * actually be the author of the
        * immediate parent comment/reply.
        */
        && get(parentPath)
          .data.userId
          == data.replyToUserId;
    }

    function isPublicReflectionOwnedBy(
      reflectionId,
      postOwnerId
    ) {
      let reflectionPath =
        /databases/$(database)/documents/reflectionPosts/$(reflectionId);

      return exists(reflectionPath)
        && get(reflectionPath).data.userId == postOwnerId
        && get(reflectionPath).data.isPrivate == false;
    }

    function followsPostOwner(
      followerId,
      postOwnerId
    ) {
      let followId =
        followerId + '_' + postOwnerId;

      let followPath =
        /databases/$(database)/documents/follows/$(followId);

      return followerId != postOwnerId
        && exists(followPath)
        && get(followPath).data.followerId == followerId
        && get(followPath).data.followingId == postOwnerId;
    }

    function hasValidSocialNotificationShape(data) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'actorUserId',
          'type',
          'reflectionId',
          'commentId',
          'createdAt',
          'readAt'
        ])
        && data.keys().hasAll([
          'id',
          'userId',
          'actorUserId',
          'type',
          'createdAt',
          'readAt'
        ])
        && data.id is string
        && data.userId is string
        && data.actorUserId is string
        && data.userId != data.actorUserId
        && data.type in [
          'follow',
          'like',
          'comment',
          'reply'
        ]
        && isIsoDate(data.createdAt)
        && (
          data.readAt == null
          || isIsoDate(data.readAt)
        )
        && (
          !data.keys().hasAny([
            'reflectionId'
          ])
          || data.reflectionId is string
        )
        && (
          !data.keys().hasAny([
            'commentId'
          ])
          || data.commentId is string
        )
        && (
          /*
          * FOLLOW
          */
          (
            data.type == 'follow'
            && !data.keys().hasAny([
              'reflectionId',
              'commentId'
            ])
          )

          ||

          /*
          * LIKE
          */
          (
            data.type == 'like'
            && data.keys().hasAll([
              'reflectionId'
            ])
            && !data.keys().hasAny([
              'commentId'
            ])
          )

          ||

          /*
          * COMMENT OR REPLY
          */
          (
            (
              data.type == 'comment'
              || data.type == 'reply'
            )
            && data.keys().hasAll([
              'reflectionId',
              'commentId'
            ])
          )
        );
    }

    function createsMatchingLikeNotification(data) {
      let likeId =
        data.reflectionId
        + '_'
        + data.actorUserId;

      let likePath =
        /databases/$(database)/documents/reflectionLikes/$(likeId);

      return existsAfter(likePath)
        && getAfter(likePath).data.id
          == likeId
        && getAfter(likePath).data.reflectionId
          == data.reflectionId
        && getAfter(likePath).data.postOwnerId
          == data.userId
        && getAfter(likePath).data.userId
          == data.actorUserId
        && getAfter(likePath).data.createdAt
          == data.createdAt;
    }

    function createsMatchingCommentNotification(data) {
      let commentPath =
        /databases/$(database)/documents/reflectionComments/$(data.commentId);

      return existsAfter(commentPath)
        && getAfter(commentPath).data.id
          == data.commentId
        && getAfter(commentPath).data.reflectionId
          == data.reflectionId
        && getAfter(commentPath).data.postOwnerId
          == data.userId
        && getAfter(commentPath).data.userId
          == data.actorUserId
        && getAfter(commentPath).data.createdAt
          == data.createdAt;
    }

    function createsMatchingReplyNotification(data) {
      let replyPath =
        /databases/$(database)/documents/reflectionComments/$(data.commentId);

      return existsAfter(replyPath)

        /*
        * The newly-created document really
        * is a reply.
        */
        && getAfter(replyPath)
          .data.keys()
          .hasAll([
            'parentCommentId',
            'replyToUserId'
          ])

        /*
        * Same reflection.
        */
        && getAfter(replyPath)
          .data.reflectionId
          == data.reflectionId

        /*
        * Person creating reply =
        * notification actor.
        */
        && getAfter(replyPath)
          .data.userId
          == data.actorUserId

        /*
        * Person being replied to =
        * notification recipient.
        */
        && getAfter(replyPath)
          .data.replyToUserId
          == data.userId

        /*
        * Same event time.
        */
        && getAfter(replyPath)
          .data.createdAt
          == data.createdAt

        /*
        * Reflection must still be public.
        */
        && isPublicReflectionOwnedBy(
          data.reflectionId,
          getAfter(replyPath)
            .data.postOwnerId
        );
    }

    function createsMatchingFollow(data) {
      let followId =
        data.actorUserId
        + '_'
        + data.userId;

      return !exists(
          /databases/$(database)/documents/follows/$(followId)
        )
        && existsAfter(
          /databases/$(database)/documents/follows/$(followId)
        )
        && getAfter(
          /databases/$(database)/documents/follows/$(followId)
        ).data.followerId == data.actorUserId
        && getAfter(
          /databases/$(database)/documents/follows/$(followId)
        ).data.followingId == data.userId
        && getAfter(
          /databases/$(database)/documents/follows/$(followId)
        ).data.createdAt == data.createdAt;
    }

    // Account metadata is private and keyed by the Firebase Authentication UID.
    match /users/{userId} {
      allow get: if isCurrentUser(userId);
      allow list: if false;

      allow create: if isCurrentUser(userId)
        && request.resource.data.id == userId
        && (
          request.auth.token.email == null
          || request.resource.data.email == request.auth.token.email
        )
        && request.resource.data.get('isGuest', false)
          == (request.auth.token.firebase.sign_in_provider == 'anonymous')
        && request.resource.data.get('authProvider', 'password')
          == authProviderName()
        && hasValidUserShape(request.resource.data);

      allow update: if isCurrentUser(userId)
        && hasValidUserShape(request.resource.data)
        && request.resource.data.id == resource.data.id
        && (
          (
            request.resource.data.email == resource.data.email
            && request.resource.data.get('isGuest', false)
              == resource.data.get('isGuest', false)
            && request.resource.data.get('authProvider', 'password')
              == resource.data.get('authProvider', 'password')
          )
          || (
            resource.data.get('isGuest', false) == true
            && request.resource.data.get('isGuest', false) == false
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.get('authProvider', 'password')
              == authProviderName()
            && authProviderName() != 'guest'
          )
        )
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isCurrentUser(userId);
    }

    // Public-facing profile data is still owner-accessible only. hiddenStory is
    // forbidden by this schema and stored separately in privateProfiles/{uid}.
    match /profiles/{profileId} {
      // Path ownership also permits a missing-document read to return exists=false.
      allow get: if isCurrentUser(profileId);
      allow list: if false;

      allow create: if isCurrentUser(profileId)
        && ownsIncomingDocument()
        && request.resource.data.id == profileId
        && request.resource.data.userId == profileId
        && hasValidProfileShape(request.resource.data);

      allow update: if isCurrentUser(profileId)
        && ownsExistingDocument()
        && ownsIncomingDocument()
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && hasValidProfileShape(request.resource.data);

      // Account cleanup may delete this UID-keyed document when it is absent.
      allow delete: if isCurrentUser(profileId);
    }

    // Sensitive profile fields have a separate owner-only document. No list or
    // public projection is permitted.
    match /privateProfiles/{userId} {
      allow get: if isCurrentUser(userId);
      allow list: if false;

      allow create: if isCurrentUser(userId)
        && request.resource.data.userId == userId
        && hasValidPrivateProfileShape(request.resource.data);

      allow update: if isCurrentUser(userId)
        && resource.data.userId == userId
        && request.resource.data.userId == userId
        && hasValidPrivateProfileShape(request.resource.data);

      allow delete: if isCurrentUser(userId);
    }

    match /profileImageHistory/{entryId} {
      allow get, list: if ownsExistingDocument();

      allow create: if ownsIncomingDocument()
        && request.resource.data.id == entryId
        && hasValidProfileImageHistoryShape(request.resource.data);

      allow update: if ownsExistingDocument()
        && ownsIncomingDocument()
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && hasValidProfileImageHistoryShape(request.resource.data);

      allow delete: if ownsExistingDocument();
    }

    match /profileJourneyEvents/{eventId} {
      allow get, list:
        if ownsExistingDocument();

      allow create:
        if ownsIncomingDocument()

        && request.resource.data.id
          == eventId

        && request.resource.data.keys().hasOnly([
          'id',
          'userId',
          'changes',
          'imagePath',
          'createdAt'
        ])

        && request.resource.data.keys().hasAll([
          'id',
          'userId',
          'changes',
          'createdAt'
        ])

        && request.resource.data.id
          is string

        && request.resource.data.userId
          is string

        && request.resource.data.changes
          is list

        && request.resource.data.changes.size()
          <= 20

        /*
        * A Journey event must contain
        * either a text change or an
        * actual profile image.
        */
        && (
          request.resource.data.changes.size()
            > 0

          ||

          (
            request.resource.data.keys().hasAny([
              'imagePath'
            ])

            && request.resource.data.imagePath
              != ''
          )
        )

        /*
        * If an imagePath exists,
        * it must belong to this user.
        */
        && (
          !request.resource.data.keys().hasAny([
            'imagePath'
          ])

          ||

          hasValidProfileImagePath(
            request.resource.data.imagePath,
            request.resource.data.userId
          )
        )

        && isIsoDate(
          request.resource.data.createdAt
        );

      allow update: if false;

      allow delete:
        if ownsExistingDocument();
    }

    match /drafts/{draftId} {
      allow get: if isCurrentUser(draftId);
      allow list: if false;

      allow create: if isCurrentUser(draftId)
        && ownsIncomingDocument()
        && request.resource.data.id == draftId
        && request.resource.data.userId == draftId
        && hasValidDraftShape(request.resource.data);

      allow update: if isCurrentUser(draftId)
        && ownsExistingDocument()
        && ownsIncomingDocument()
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId
        && hasValidDraftShape(request.resource.data);

      allow delete: if isCurrentUser(draftId);
    }

    match /reflectionPosts/{reflectionId} {
      allow get, list: if signedIn()
      && (
        resource.data.userId == request.auth.uid
        || resource.data.isPrivate == false
      );

      allow create: if ownsIncomingDocument()
        && request.resource.data.id == reflectionId
        && hasValidReflectionShape(request.resource.data);

      allow update: if ownsExistingDocument()
        && ownsIncomingDocument()
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId
        && hasValidReflectionShape(request.resource.data);

      allow delete: if ownsExistingDocument();
    }

    match /socialProfiles/{userId} {
      allow get, list: if signedIn();

      allow create: if isCurrentUser(userId)
        && request.resource.data.id == userId
        && request.resource.data.userId == userId
        && hasValidSocialProfileShape(request.resource.data);

      allow update: if isCurrentUser(userId)
        && resource.data.id == userId
        && resource.data.userId == userId
        && request.resource.data.id == userId
        && request.resource.data.userId == userId
        && request.resource.data.createdAt == resource.data.createdAt
        && hasValidSocialProfileShape(request.resource.data);

      allow delete: if isCurrentUser(userId);
    }

    match /follows/{followId} {
      allow get, list: if signedIn();

      allow create: if signedIn()
        && request.resource.data.followerId
          == request.auth.uid
        && request.resource.data.followingId
          != request.auth.uid
        && request.resource.data.id
          == followId
        && followId ==
          request.resource.data.followerId
          + '_'
          + request.resource.data.followingId
        && hasValidFollowShape(
          request.resource.data
        );

      allow update: if false;

      allow delete: if signedIn()
        && (
          resource.data.followerId
            == request.auth.uid
          || resource.data.followingId
            == request.auth.uid
        );
    }

    match /reflectionLikes/{likeId} {
      /*
      * Likes may only be read when the associated
      * reflection is public.
      *
      * This lets Community display Like counts while
      * preventing social interaction data from being
      * exposed for private reflections.
      */
      allow get, list: if signedIn();
      /*
      * Only the currently authenticated user can
      * create a Like in their own name.
      *
      * The user must:
      * - not be the post owner
      * - follow the post owner
      * - like an existing PUBLIC reflection
      */
      allow create: if signedIn()
        && request.resource.data.userId
          == request.auth.uid
        && request.resource.data.postOwnerId
          != request.auth.uid
        && request.resource.data.id
          == likeId
        && likeId ==
          request.resource.data.reflectionId
          + '_'
          + request.auth.uid
        && hasValidReflectionLikeShape(
          request.resource.data
        )
        && isPublicReflectionOwnedBy(
          request.resource.data.reflectionId,
          request.resource.data.postOwnerId
        )
        && followsPostOwner(
          request.auth.uid,
          request.resource.data.postOwnerId
        );

      /*
      * Likes should not be edited.
      * Unlike = delete the Like document.
      */
      allow update: if false;

      /*
      * The person who liked the reflection may unlike it.
      *
      * The post owner may also delete it so account/post
      * cleanup can remove interaction documents later.
      */
      allow delete: if signedIn()
        && (
          resource.data.userId
            == request.auth.uid
          || resource.data.postOwnerId
            == request.auth.uid
        );
    }

    match /reflectionComments/{commentId} {
      /*
      * Comments may only be read when their associated
      * reflection is public.
      */
      allow get, list: if signedIn();

      /*
      * Only the currently authenticated user can
      * create a comment in their own name.
      *
      * They must follow the reflection owner.
      */
      allow create: if signedIn()

      /*
      * Nobody may submit a comment/reply
      * pretending to be another user.
      */
      && request.resource.data.userId
        == request.auth.uid

      && request.resource.data.id
        == commentId

      && hasValidReflectionCommentShape(
        request.resource.data
      )

      /*
      * Absolutely no comments or replies
      * on private reflections.
      */
      && isPublicReflectionOwnedBy(
        request.resource.data.reflectionId,
        request.resource.data.postOwnerId
      )

      && (
        /*
        * NORMAL TOP-LEVEL COMMENT:
        *
        * must follow the post owner.
        */
        (
          !request.resource.data
            .keys()
            .hasAny([
              'parentCommentId',
              'replyToUserId'
            ])

          && request.resource.data
            .postOwnerId
            != request.auth.uid

          && followsPostOwner(
            request.auth.uid,
            request.resource.data.postOwnerId
          )
        )

        ||

        /*
        * REPLY:
        *
        * Any signed-in user may reply.
        * Following the post owner is NOT
        * required.
        */
        (
          request.resource.data
            .keys()
            .hasAll([
              'parentCommentId',
              'replyToUserId'
            ])

          && isValidReplyTarget(
            request.resource.data
          )
        )
      );

      /*
      * We have not implemented Edit Comment yet.
      */
      allow update: if false;

      /*
      * Comment author may delete their comment.
      * Reflection owner may also remove a comment.
      */
      allow delete: if signedIn()
        && (
          resource.data.userId
            == request.auth.uid
          || resource.data.postOwnerId
            == request.auth.uid
        );
    }

    match /notifications/{notificationId} {
      allow get, list: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || resource.data.actorUserId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.actorUserId == request.auth.uid
        && request.resource.data.userId != request.auth.uid
        && request.resource.data.id == notificationId
        && request.resource.data.readAt == null
        && hasValidSocialNotificationShape(
          request.resource.data
        )
        && (
          (
            request.resource.data.type == 'follow'
            && notificationId ==
              request.resource.data.actorUserId
              + '_'
              + request.resource.data.userId
              + '_'
              + request.resource.data.createdAt
            && createsMatchingFollow(
              request.resource.data
            )
          )

          ||

          (
            request.resource.data.type == 'like'
            && notificationId ==
              'like_'
              + request.resource.data.reflectionId
              + '_'
              + request.resource.data.actorUserId
              + '_'
              + request.resource.data.createdAt
            && isPublicReflectionOwnedBy(
              request.resource.data.reflectionId,
              request.resource.data.userId
            )
            && createsMatchingLikeNotification(
              request.resource.data
            )
          )

          ||

          (
            request.resource.data.type == 'comment'
            && notificationId ==
              'comment_'
              + request.resource.data.commentId
            && isPublicReflectionOwnedBy(
              request.resource.data.reflectionId,
              request.resource.data.userId
            )
            && createsMatchingCommentNotification(
              request.resource.data
            )
          )

          ||

          /*
          * REPLY
          */
          (
            request.resource.data.type
              == 'reply'

            && notificationId ==
              'reply_'
              + request.resource.data.commentId

            && createsMatchingReplyNotification(
              request.resource.data
            )
          )
        );

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'readAt'
          ])
        && request.resource.data.readAt != null
        && isIsoDate(
          request.resource.data.readAt
        )
        && hasValidSocialNotificationShape(
          request.resource.data
        );

      allow delete: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || resource.data.actorUserId == request.auth.uid
        );
    }

    /*
    * This is NOT inside notifications.
    * This denies access to any collection
    * that does not have its own rule above.
    */
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
