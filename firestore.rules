rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isCurrentUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function authProviderName() {
      return 'password';
    }

    function ownsExistingDocument() {
      return signedIn()
        && resource.data.userId is string
        && resource.data.userId == request.auth.uid;
    }

    function ownsIncomingDocument() {
      return signedIn()
        && request.resource.data.userId is string
        && request.resource.data.userId == request.auth.uid;
    }

    function isShortString(value, maximumLength) {
      return value is string && value.size() <= maximumLength;
    }

    function hasValidProfileImagePath(value, userId) {
      return isShortString(value, 512)
        && (
          value == ''
          || value.matches(
            '^users/' + userId
              + '/profile/[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-'
              + '[1-5][0-9A-Fa-f]{3}-[89AaBb][0-9A-Fa-f]{3}-'
              + '[0-9A-Fa-f]{12}[.](jpg|png|webp)$'
          )
        );
    }

    function hasValidCoverColor(value) {
      return isShortString(value, 7)
        && value.matches('^#[0-9A-Fa-f]{6}$');
    }

    function hasValidCoverImageId(value) {
      return isShortString(value, 32)
        && (value == '' || value.matches('^cover-[0-9]{2}$'));
    }

    function hasValidLegacyCoverImagePath(value, userId) {
      return isShortString(value, 512)
        && (
          value == ''
          || value.matches(
            '^users/' + userId
              + '/cover/[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-'
              + '[1-5][0-9A-Fa-f]{3}-[89AaBb][0-9A-Fa-f]{3}-'
              + '[0-9A-Fa-f]{12}[.](jpg|png|webp)$'
          )
        );
    }

    function isStringList(value, maximumItems) {
      return value is list && value.size() <= maximumItems;
    }

    function isIsoDate(value) {
      return value is timestamp
        || (
          value is string
          && value.matches(
            '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$'
          )
        );
    }

    function hasValidPrivacyPreferences(value) {
      return value is map
        && value.keys().hasOnly([
          'accountPrivate',
          'requirePrivateCheck',
          'showReflectionDates'
        ])
        && value.keys().hasAll([
          'requirePrivateCheck',
          'showReflectionDates'
        ])
        && (!('accountPrivate' in value) || value.accountPrivate is bool)
        && value.requirePrivateCheck is bool
        && value.showReflectionDates is bool;
    }

    function hasValidUserShape(data) {
      return data.keys().hasOnly([
          'id',
          'email',
          'username',
          'fullName',
          'role',
          'adminAccessGranted',
          'isGuest',
          'authProvider',
          'createdAt',
          'updatedAt',
          'privacyConsentAt',
          'spiritualIntroSeenAt',
          'fiatIntroSeenAt',
          'profileCompleted',
          'mustChangePassword',
          'privacyPreferences'
        ])
        && data.keys().hasAll([
          'id',
          'email',
          'createdAt',
          'updatedAt',
          'profileCompleted'
        ])
        && data.id is string
        && data.email is string
        && data.email.size() <= 320
        && (!('username' in data) || data.username is string)
        && (!('username' in data) || data.username.size() <= 80)
        && (!('fullName' in data) || isShortString(data.fullName, 120))
        && (!('role' in data) || data.role in ['user', 'tester', 'app_admin'])
        && (!('adminAccessGranted' in data) || data.adminAccessGranted is bool)
        && (!('isGuest' in data) || data.isGuest is bool)
        && (!('authProvider' in data) || data.authProvider == 'password')
        && isIsoDate(data.createdAt)
        && isIsoDate(data.updatedAt)
        && data.profileCompleted is bool
        && (!('mustChangePassword' in data) || data.mustChangePassword is bool)
        && (
          !('privacyConsentAt' in data)
          || data.privacyConsentAt == null
          || isIsoDate(data.privacyConsentAt)
        )
        && (
          !('spiritualIntroSeenAt' in data)
          || data.spiritualIntroSeenAt == null
          || isIsoDate(data.spiritualIntroSeenAt)
        )
        && (
          !('fiatIntroSeenAt' in data)
          || data.fiatIntroSeenAt == null
          || isIsoDate(data.fiatIntroSeenAt)
        )
        && (
          !('privacyPreferences' in data)
          || hasValidPrivacyPreferences(data.privacyPreferences)
        );
    }

    function hasValidProfileShape(data) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'profileName',
          'coverColor',
          'coverImageId',
          'coverImagePath',
          'imagePath',
          'selectedSymbol',
          'spiritualBio',
          'spiritualGuides',
          'lifeDirections',
          'heartSeeks',
          'godsComment',
          'heavenlyHashtag',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'id',
          'userId',
          'profileName',
          'imagePath',
          'selectedSymbol',
          'spiritualBio',
          'spiritualGuides',
          'lifeDirections',
          'heartSeeks',
          'godsComment',
          'heavenlyHashtag',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.userId is string
        && isShortString(data.profileName, 60)
        && data.profileName.size() > 0
        && (!('coverColor' in data) || hasValidCoverColor(data.coverColor))
        && (!('coverImageId' in data) || hasValidCoverImageId(data.coverImageId))
        && (!('coverImagePath' in data) || hasValidLegacyCoverImagePath(data.coverImagePath, data.userId))
        && hasValidProfileImagePath(data.imagePath, data.userId)
        && data.selectedSymbol in [
          '',
          'candle',
          'seed',
          'cross',
          'heart',
          'open-hands',
          'road'
        ]
        && (data.imagePath == '' || data.selectedSymbol == '')
        && isShortString(data.spiritualBio, 320)
        && isStringList(data.spiritualGuides, 30)
        && isStringList(data.lifeDirections, 30)
        && isStringList(data.heartSeeks, 30)
        && isShortString(data.godsComment, 280)
        && isShortString(data.heavenlyHashtag, 40)
        && isIsoDate(data.createdAt)
        && isIsoDate(data.updatedAt);
    }

    function hasValidPrivateProfileShape(data) {
      return data.keys().hasOnly([
          'userId',
          'hiddenStory',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'userId',
          'hiddenStory',
          'updatedAt'
        ])
        && data.userId is string
        && isShortString(data.hiddenStory, 1000)
        && isIsoDate(data.updatedAt);
    }

    function hasValidProfileImageHistoryShape(data) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'imagePath',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'id',
          'userId',
          'imagePath',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.userId is string
        && hasValidProfileImagePath(data.imagePath, data.userId)
        && isIsoDate(data.createdAt)
        && isIsoDate(data.updatedAt);
    }

    function hasValidDraftData(value, userId) {
      return value is map
        && value.keys().hasOnly([
          'profileName',
          'imagePath',
          'selectedSymbol',
          'spiritualBio',
          'spiritualGuides',
          'lifeDirections',
          'onboardingPostTitles',
          'onboardingPosts',
          'heartSeeks',
          'hiddenStory',
          'godsComment',
          'heavenlyHashtag'
        ])
        && value.keys().hasAll([
          'profileName',
          'imagePath',
          'selectedSymbol',
          'spiritualBio',
          'spiritualGuides',
          'lifeDirections',
          'onboardingPosts',
          'heartSeeks',
          'hiddenStory',
          'godsComment',
          'heavenlyHashtag'
        ])
        && isShortString(value.profileName, 60)
        && hasValidProfileImagePath(value.imagePath, userId)
        && value.selectedSymbol in [
          '',
          'candle',
          'seed',
          'cross',
          'heart',
          'open-hands',
          'road'
        ]
        && (value.imagePath == '' || value.selectedSymbol == '')
        && isShortString(value.spiritualBio, 320)
        && isStringList(value.spiritualGuides, 30)
        && isStringList(value.lifeDirections, 30)
        && (
          !value.keys().hasAny(['onboardingPostTitles'])
          || isStringList(value.onboardingPostTitles, 20)
        )
        && isStringList(value.onboardingPosts, 20)
        && isStringList(value.heartSeeks, 30)
        && isShortString(value.hiddenStory, 1000)
        && isShortString(value.godsComment, 280)
        && isShortString(value.heavenlyHashtag, 40);
    }

    function hasValidDraftShape(data) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'currentStep',
          'draftData',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'id',
          'userId',
          'currentStep',
          'draftData',
          'updatedAt'
        ])
        && data.id is string
        && data.userId is string
        && data.currentStep is int
        && data.currentStep >= 0
        && data.currentStep <= 10
        && hasValidDraftData(data.draftData, data.userId)
        && isIsoDate(data.updatedAt);
    }

    function hasValidReflectionShape(data) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'title',
          'content',
          'isPrivate',
          'accountPrivate',
          'createdAt',
          'updatedAt',
          'editedAt',
          'fiatCategory',
          'fiatDateKey',
          'fiatOther',
          'media'
        ])
        && data.keys().hasAll([
          'id',
          'userId',
          'title',
          'content',
          'isPrivate',
          'accountPrivate',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.userId is string
        && (!data.keys().hasAny(['title']) || isShortString(data.title, 60))
        && isShortString(data.content, 500)
        && data.content.size() > 0
        && data.isPrivate is bool
        && data.accountPrivate is bool
        && (
          !data.keys().hasAny(['media'])
          || (
            data.media is list
            && data.media.size() <= 5
            && (data.media.size() < 1 || hasValidReflectionMedia(data.media[0], data.userId, data.id))
            && (data.media.size() < 2 || hasValidReflectionMedia(data.media[1], data.userId, data.id))
            && (data.media.size() < 3 || hasValidReflectionMedia(data.media[2], data.userId, data.id))
            && (data.media.size() < 4 || hasValidReflectionMedia(data.media[3], data.userId, data.id))
            && (data.media.size() < 5 || hasValidReflectionMedia(data.media[4], data.userId, data.id))
            && (data.media.size() == 1 || (
              data.media[0].type == 'image'
              && (data.media.size() < 2 || data.media[1].type == 'image')
              && (data.media.size() < 3 || data.media[2].type == 'image')
              && (data.media.size() < 4 || data.media[3].type == 'image')
              && (data.media.size() < 5 || data.media[4].type == 'image')
            ))
          )
        )
        && (
          !data.keys().hasAny(['fiatCategory', 'fiatDateKey'])
          || (
            data.keys().hasAll(['fiatCategory', 'fiatDateKey'])
            && data.fiatCategory in [
              'prayer', 'forgiveness', 'service', 'sacrifice',
              'act-of-love', 'responsible-choice', 'other'
            ]
            && data.fiatDateKey is string
            && data.fiatDateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && (
              (
                data.fiatCategory == 'other'
                && data.keys().hasAll(['fiatOther'])
                && data.fiatOther is string
                && data.fiatOther.size() > 0
                && data.fiatOther.size() <= 25
              )
              || (
                data.fiatCategory != 'other'
                && !data.keys().hasAny(['fiatOther'])
              )
            )
          )
        )
        && isIsoDate(data.createdAt)
        && isIsoDate(data.updatedAt)
        && (!('editedAt' in data) || isIsoDate(data.editedAt));
    }

    function hasValidSocialProfileShape(data) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'profileName',
          'coverColor',
          'coverImageId',
          'coverImagePath',
          'imagePath',
          'spiritualBio',
          'heavenlyHashtag',
          'isPrivateAccount',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'id',
          'userId',
          'profileName',
          'imagePath',
          'spiritualBio',
          'heavenlyHashtag',
          'isPrivateAccount',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.userId is string
        && isShortString(data.profileName, 60)
        && data.profileName.size() > 0
        && (!('coverColor' in data) || hasValidCoverColor(data.coverColor))
        && (!('coverImageId' in data) || hasValidCoverImageId(data.coverImageId))
        && (!('coverImagePath' in data) || hasValidLegacyCoverImagePath(data.coverImagePath, data.userId))
        && hasValidProfileImagePath(data.imagePath, data.userId)
        && isShortString(data.spiritualBio, 320)
        && isShortString(data.heavenlyHashtag, 40)
        && data.isPrivateAccount is bool
        && isIsoDate(data.createdAt)
        && isIsoDate(data.updatedAt);
    }

    function hasValidFollowShape(data) {
      return data.keys().hasOnly([
          'id',
          'followerId',
          'followingId',
          'createdAt'
        ])
        && data.keys().hasAll([
          'id',
          'followerId',
          'followingId',
          'createdAt'
        ])
        && data.id is string
        && data.followerId is string
        && data.followingId is string
        && data.followerId != data.followingId
        && isIsoDate(data.createdAt);
    }

    function hasValidFollowRequestShape(data) {
      return data.keys().hasOnly([
          'id',
          'requesterId',
          'targetUserId',
          'createdAt'
        ])
        && data.keys().hasAll([
          'id',
          'requesterId',
          'targetUserId',
          'createdAt'
        ])
        && data.id is string
        && data.requesterId is string
        && data.targetUserId is string
        && data.requesterId != data.targetUserId
        && data.id ==
          data.requesterId
          + '_'
          + data.targetUserId
        && isIsoDate(data.createdAt);
    }

    function hasValidReflectionLikeShape(data) {
      return data.keys().hasOnly([
          'id',
          'reflectionId',
          'postOwnerId',
          'userId',
          'createdAt'
        ])
        && data.keys().hasAll([
          'id',
          'reflectionId',
          'postOwnerId',
          'userId',
          'createdAt'
        ])
        && data.id is string
        && data.reflectionId is string
        && data.postOwnerId is string
        && data.userId is string
        && data.postOwnerId != data.userId
        && isIsoDate(data.createdAt);
    }

    function hasValidReflectionCommentShape(data) {
      let hasParentComment =
        data.keys().hasAny([
          'parentCommentId'
        ]);

      let hasReplyTarget =
        data.keys().hasAny([
          'replyToUserId'
        ]);

      return data.keys().hasOnly([
          'id',
          'reflectionId',
          'postOwnerId',
          'userId',
          'parentCommentId',
          'replyToUserId',
          'content',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'id',
          'reflectionId',
          'postOwnerId',
          'userId',
          'content',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.reflectionId is string
        && data.postOwnerId is string
        && data.userId is string
        && data.content is string
        && data.content.size() > 0
        && data.content.size() <= 500
        && isIsoDate(data.createdAt)
        && isIsoDate(data.updatedAt)

        && (
          /*
          * NORMAL COMMENT
          */
          (
            !hasParentComment
            && !hasReplyTarget
            && data.postOwnerId
              != data.userId
          )

          ||

          /*
          * REPLY
          */
          (
            hasParentComment
            && hasReplyTarget
            && data.parentCommentId
              is string
            && data.parentCommentId
              .size() > 0
            && data.replyToUserId
              is string
            && data.replyToUserId
              .size() > 0
          )
        );
    }

    function isValidReplyTarget(data) {
      let parentPath =
        /databases/$(database)/documents/reflectionComments/$(data.parentCommentId);

      return exists(parentPath)

        /*
        * Parent must belong to the same
        * reflection.
        */
        && get(parentPath)
          .data.reflectionId
          == data.reflectionId

        /*
        * Parent must belong to the same
        * reflection owner.
        */
        && get(parentPath)
          .data.postOwnerId
          == data.postOwnerId

        /*
        * The user being replied to must
        * actually be the author of the
        * immediate parent comment/reply.
        */
        && get(parentPath)
          .data.userId
          == data.replyToUserId;
    }

    function followsPostOwner(
      followerId,
      postOwnerId
    ) {
      let followId =
        followerId + '_' + postOwnerId;

      let followPath =
        /databases/$(database)/documents/follows/$(followId);

      return followerId != postOwnerId
        && exists(followPath)
        && get(followPath).data.followerId == followerId
        && get(followPath).data.followingId == postOwnerId;
    }

    function socialProfilePath(userId) {
      return /databases/$(database)/documents/socialProfiles/$(userId);
    }

    function targetIsPrivate(userId) {
      let path = socialProfilePath(userId);

      return exists(path)
        && get(path).data.get(
          'isPrivateAccount',
          false
        ) == true;
    }

    function targetIsPublic(userId) {
      let path = socialProfilePath(userId);

      /*
      * Legacy socialProfiles documents may not contain
      * isPrivateAccount yet.
      *
      * Missing privacy flag = PUBLIC by default.
      */
      return exists(path)
        && get(path).data.get(
          'isPrivateAccount',
          false
        ) == false;
    }

    function matchingPendingFollowRequest(
      followerId,
      followingId
    ) {
      let requestId =
        followerId + '_' + followingId;

      let path =
        /databases/$(database)/documents/followRequests/$(requestId);

      return exists(path)
        && get(path).data.requesterId == followerId
        && get(path).data.targetUserId == followingId;
    }

    function incomingReflectionPrivacyMatchesUser(data) {
      let userPath =
        /databases/$(database)/documents/users/$(data.userId);

      return existsAfter(userPath)
        && getAfter(userPath)
          .data
          .get('privacyPreferences', {})
          .get('accountPrivate', false) == data.accountPrivate;
    }

    function incomingSocialPrivacyMatchesUser(data) {
      let userPath =
        /databases/$(database)/documents/users/$(data.userId);

      return existsAfter(userPath)
        && getAfter(userPath)
          .data
          .get('privacyPreferences', {})
          .get('accountPrivate', false) == data.isPrivateAccount;
    }

    function canViewReflection(data) {
      return signedIn()
        && (
          data.userId == request.auth.uid
          || (
            data.isPrivate == false
            && (
              data.accountPrivate == false
              || followsPostOwner(
                request.auth.uid,
                data.userId
              )
            )
          )
        );
    }

    function isPublicReflectionOwnedBy(
      reflectionId,
      postOwnerId
    ) {
      let reflectionPath =
        /databases/$(database)/documents/reflectionPosts/$(reflectionId);

      return exists(reflectionPath)
        && get(reflectionPath).data.userId == postOwnerId
        && get(reflectionPath).data.isPrivate == false
        && (
          get(reflectionPath).data.accountPrivate == false
          || followsPostOwner(
            request.auth.uid,
            postOwnerId
          )
        );
    }

    function hasValidSocialNotificationShape(data) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'actorUserId',
          'type',
          'reflectionId',
          'commentId',
          'createdAt',
          'readAt'
        ])
        && data.keys().hasAll([
          'id',
          'userId',
          'actorUserId',
          'type',
          'createdAt',
          'readAt'
        ])
        && data.id is string
        && data.userId is string
        && data.actorUserId is string
        && data.userId != data.actorUserId
        && data.type in [
          'follow',
          'like',
          'comment',
          'reply'
        ]
        && isIsoDate(data.createdAt)
        && (
          data.readAt == null
          || isIsoDate(data.readAt)
        )
        && (
          !data.keys().hasAny([
            'reflectionId'
          ])
          || data.reflectionId is string
        )
        && (
          !data.keys().hasAny([
            'commentId'
          ])
          || data.commentId is string
        )
        && (
          /*
          * FOLLOW
          */
          (
            data.type == 'follow'
            && !data.keys().hasAny([
              'reflectionId',
              'commentId'
            ])
          )

          ||

          /*
          * LIKE
          */
          (
            data.type == 'like'
            && data.keys().hasAll([
              'reflectionId'
            ])
            && !data.keys().hasAny([
              'commentId'
            ])
          )

          ||

          /*
          * COMMENT OR REPLY
          */
          (
            (
              data.type == 'comment'
              || data.type == 'reply'
            )
            && data.keys().hasAll([
              'reflectionId',
              'commentId'
            ])
          )
        );
    }

    function createsMatchingLikeNotification(data) {
      let likeId =
        data.reflectionId
        + '_'
        + data.actorUserId;

      let likePath =
        /databases/$(database)/documents/reflectionLikes/$(likeId);

      return existsAfter(likePath)
        && getAfter(likePath).data.id
          == likeId
        && getAfter(likePath).data.reflectionId
          == data.reflectionId
        && getAfter(likePath).data.postOwnerId
          == data.userId
        && getAfter(likePath).data.userId
          == data.actorUserId
        && getAfter(likePath).data.createdAt
          == data.createdAt;
    }

    function createsMatchingCommentNotification(data) {
      let commentPath =
        /databases/$(database)/documents/reflectionComments/$(data.commentId);

      return existsAfter(commentPath)
        && getAfter(commentPath).data.id
          == data.commentId
        && getAfter(commentPath).data.reflectionId
          == data.reflectionId
        && getAfter(commentPath).data.postOwnerId
          == data.userId
        && getAfter(commentPath).data.userId
          == data.actorUserId
        && getAfter(commentPath).data.createdAt
          == data.createdAt;
    }

    function createsMatchingReplyNotification(data) {
      let replyPath =
        /databases/$(database)/documents/reflectionComments/$(data.commentId);

      return existsAfter(replyPath)

        /*
        * The newly-created document really
        * is a reply.
        */
        && getAfter(replyPath)
          .data.keys()
          .hasAll([
            'parentCommentId',
            'replyToUserId'
          ])

        /*
        * Same reflection.
        */
        && getAfter(replyPath)
          .data.reflectionId
          == data.reflectionId

        /*
        * Person creating reply =
        * notification actor.
        */
        && getAfter(replyPath)
          .data.userId
          == data.actorUserId

        /*
        * Person being replied to =
        * notification recipient.
        */
        && getAfter(replyPath)
          .data.replyToUserId
          == data.userId

        /*
        * Same event time.
        */
        && getAfter(replyPath)
          .data.createdAt
          == data.createdAt

        /*
        * Reflection must still be public.
        */
        && isPublicReflectionOwnedBy(
          data.reflectionId,
          getAfter(replyPath)
            .data.postOwnerId
        );
    }

    function createsMatchingFollow(data) {
      let followId =
        data.actorUserId
        + '_'
        + data.userId;

      return !exists(
          /databases/$(database)/documents/follows/$(followId)
        )
        && existsAfter(
          /databases/$(database)/documents/follows/$(followId)
        )
        && getAfter(
          /databases/$(database)/documents/follows/$(followId)
        ).data.followerId == data.actorUserId
        && getAfter(
          /databases/$(database)/documents/follows/$(followId)
        ).data.followingId == data.userId
        && getAfter(
          /databases/$(database)/documents/follows/$(followId)
        ).data.createdAt == data.createdAt;
    }

    // Account metadata is private and keyed by the Firebase Authentication UID.
    match /users/{userId} {
      allow get: if isCurrentUser(userId);
      allow list: if false;

      allow create: if isCurrentUser(userId)
        && request.resource.data.id == userId
        && (
          request.auth.token.get('email', null) == null
          || request.resource.data.email == request.auth.token.get('email', null)
        )
        && request.resource.data.get('isGuest', false)
          == false
        && request.resource.data.get('authProvider', 'password')
          == authProviderName()
        && request.resource.data.get('adminAccessGranted', false) == false
        && hasValidUserShape(request.resource.data);

      allow update: if isCurrentUser(userId)
        && hasValidUserShape(request.resource.data)
        && request.resource.data.id == resource.data.id
        && (
          (
            request.resource.data.email == resource.data.email
            && request.resource.data.get('isGuest', false)
              == resource.data.get('isGuest', false)
            && request.resource.data.get('authProvider', 'password')
              == resource.data.get('authProvider', 'password')
          )
          || (
            resource.data.get('isGuest', false) == true
            && request.resource.data.get('isGuest', false) == false
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.get('authProvider', 'password')
              == authProviderName()
            && authProviderName() != 'guest'
          )
        )
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('username', '')
          == resource.data.get('username', '')
        && request.resource.data.get('fullName', '')
          == resource.data.get('fullName', '')
        && request.resource.data.get('role', 'user')
          == resource.data.get('role', 'user')
        && request.resource.data.get('adminAccessGranted', false)
          == resource.data.get('adminAccessGranted', false);

      allow delete: if isCurrentUser(userId);
    }

    // Public-facing profile data is still owner-accessible only. hiddenStory is
    // forbidden by this schema and stored separately in privateProfiles/{uid}.
    match /profiles/{profileId} {
      // Path ownership also permits a missing-document read to return exists=false.
      allow get: if isCurrentUser(profileId);
      allow list: if false;

      allow create: if isCurrentUser(profileId)
        && ownsIncomingDocument()
        && request.resource.data.id == profileId
        && request.resource.data.userId == profileId
        && hasValidProfileShape(request.resource.data);

      allow update: if isCurrentUser(profileId)
        && ownsExistingDocument()
        && ownsIncomingDocument()
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && hasValidProfileShape(request.resource.data);

      // Account cleanup may delete this UID-keyed document when it is absent.
      allow delete: if isCurrentUser(profileId);
    }

    // Sensitive profile fields have a separate owner-only document. No list or
    // public projection is permitted.
    match /privateProfiles/{userId} {
      allow get: if isCurrentUser(userId);
      allow list: if false;

      allow create: if isCurrentUser(userId)
        && request.resource.data.userId == userId
        && hasValidPrivateProfileShape(request.resource.data);

      allow update: if isCurrentUser(userId)
        && resource.data.userId == userId
        && request.resource.data.userId == userId
        && hasValidPrivateProfileShape(request.resource.data);

      allow delete: if isCurrentUser(userId);
    }

    match /profileImageHistory/{entryId} {
      allow get, list: if ownsExistingDocument();

      allow create: if ownsIncomingDocument()
        && request.resource.data.id == entryId
        && hasValidProfileImageHistoryShape(request.resource.data);

      allow update: if ownsExistingDocument()
        && ownsIncomingDocument()
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && hasValidProfileImageHistoryShape(request.resource.data);

      allow delete: if ownsExistingDocument();
    }

    match /profileJourneyEvents/{eventId} {
      allow get, list:
        if ownsExistingDocument();

      allow create:
        if ownsIncomingDocument()

        && request.resource.data.id
          == eventId

        && request.resource.data.keys().hasOnly([
          'id',
          'userId',
          'changes',
          'imagePath',
          'createdAt'
        ])

        && request.resource.data.keys().hasAll([
          'id',
          'userId',
          'changes',
          'createdAt'
        ])

        && request.resource.data.id
          is string

        && request.resource.data.userId
          is string

        && request.resource.data.changes
          is list

        && request.resource.data.changes.size()
          > 0

        && request.resource.data.changes.size()
          <= 20

        && (
          !request.resource.data.keys().hasAny([
            'imagePath'
          ])

          ||

          hasValidProfileImagePath(
            request.resource.data.imagePath,
            request.resource.data.userId
          )
        )

        && isIsoDate(
          request.resource.data.createdAt
        );

      allow update: if false;

      allow delete:
        if ownsExistingDocument();
    }

    match /drafts/{draftId} {
      allow get: if isCurrentUser(draftId);
      allow list: if false;

      allow create: if isCurrentUser(draftId)
        && ownsIncomingDocument()
        && request.resource.data.id == draftId
        && request.resource.data.userId == draftId
        && hasValidDraftShape(request.resource.data);

      allow update: if isCurrentUser(draftId)
        && ownsExistingDocument()
        && ownsIncomingDocument()
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId
        && hasValidDraftShape(request.resource.data);

      allow delete: if isCurrentUser(draftId);
    }

    // Bulletin documents are published by the server-side admin service.
    // Authenticated users may read them; client-side writes remain denied.
    match /bulletins/{bulletinId} {
      allow get, list: if signedIn();
      allow create, update, delete: if false;
    }

    match /reflectionPosts/{reflectionId} {
      allow get, list: if canViewReflection(resource.data);

      allow create: if ownsIncomingDocument()
        && request.resource.data.id == reflectionId
        && hasValidReflectionShape(request.resource.data)
        && incomingReflectionPrivacyMatchesUser(
          request.resource.data
        );

      allow update: if ownsExistingDocument()
        && ownsIncomingDocument()
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId
        && hasValidReflectionShape(request.resource.data)
        && incomingReflectionPrivacyMatchesUser(
          request.resource.data
        );

      allow delete: if ownsExistingDocument();
    }

    match /socialProfiles/{userId} {
      // Private accounts remain searchable.
      allow get, list: if signedIn();

      allow create: if isCurrentUser(userId)
        && request.resource.data.id == userId
        && request.resource.data.userId == userId
        && hasValidSocialProfileShape(request.resource.data)
        && incomingSocialPrivacyMatchesUser(
          request.resource.data
        );

      allow update: if isCurrentUser(userId)
        && resource.data.id == userId
        && resource.data.userId == userId
        && request.resource.data.id == userId
        && request.resource.data.userId == userId
        && request.resource.data.createdAt == resource.data.createdAt
        && hasValidSocialProfileShape(request.resource.data)
        && incomingSocialPrivacyMatchesUser(
          request.resource.data
        );

      allow delete: if isCurrentUser(userId);
    }

    match /followRequests/{requestId} {

      /*
      * ==========================================================
      * READ SINGLE FOLLOW REQUEST
      * ==========================================================
      *
      * The requester needs to be able to check whether:
      *
      * requesterUID_targetUID
      *
      * already exists.
      *
      * The target may also inspect incoming requests.
      */
      allow get: if signedIn()
        && (
          requestId.matches(
            request.auth.uid + '_.*'
          )
          ||
          requestId.matches(
            '.*_' + request.auth.uid
          )
        );

      /*
      * ==========================================================
      * QUERY FOLLOW REQUESTS
      * ==========================================================
      */
      allow list: if signedIn()
        && (
          resource.data.requesterId
            == request.auth.uid
          ||
          resource.data.targetUserId
            == request.auth.uid
        );

      /*
      * ==========================================================
      * CREATE PRIVATE FOLLOW REQUEST
      * ==========================================================
      */
      allow create: if signedIn()

        && request.resource.data.id
          == requestId

        && request.resource.data.requesterId
          == request.auth.uid

        && request.resource.data.targetUserId
          != request.auth.uid

        && requestId
          ==
            request.resource.data.requesterId
            + '_'
            + request.resource.data.targetUserId

        && hasValidFollowRequestShape(
          request.resource.data
        )

        /*
        * A request can only be created for an explicitly
        * private social profile.
        */
        && targetIsPrivate(
          request.resource.data.targetUserId
        )

        /*
        * Don't create a request if already following.
        */
        && !exists(
          /databases/$(database)/documents/follows/$(requestId)
        );

      /*
      * Follow requests cannot be edited.
      */
      allow update: if false;

      /*
      * Requester:
      *   cancel request.
      *
      * Target:
      *   approve/reject request.
      */
      allow delete: if signedIn()
        && (
          resource.data.requesterId
            == request.auth.uid
          ||
          resource.data.targetUserId
            == request.auth.uid
        );
    }


    match /follows/{followId} {

      /*
      * Follow relationships are visible to authenticated
      * Saintagram users.
      */
      allow get, list: if signedIn();

      /*
      * ==========================================================
      * CREATE FOLLOW
      * ==========================================================
      */
      allow create: if signedIn()

        && request.resource.data.id
          == followId

        && followId
          ==
            request.resource.data.followerId
            + '_'
            + request.resource.data.followingId

        && hasValidFollowShape(
          request.resource.data
        )

        && (

          /*
          * ========================================================
          * PUBLIC ACCOUNT
          * ========================================================
          *
          * Requester may immediately follow.
          *
          * Missing legacy isPrivateAccount is treated as false.
          */
          (
            request.resource.data.followerId
              == request.auth.uid

            && request.resource.data.followingId
              != request.auth.uid

            && targetIsPublic(
              request.resource.data.followingId
            )
          )

          ||

          /*
          * ========================================================
          * PRIVATE ACCOUNT
          * ========================================================
          *
          * The PRIVATE ACCOUNT OWNER creates the relationship
          * when approving a valid pending request.
          */
          (
            request.resource.data.followingId
              == request.auth.uid

            && request.resource.data.followerId
              != request.auth.uid

            && targetIsPrivate(
              request.resource.data.followingId
            )

            && matchingPendingFollowRequest(
              request.resource.data.followerId,
              request.resource.data.followingId
            )
          )
        );

      /*
      * Relationships are immutable.
      */
      allow update: if false;

      /*
      * Either participant can remove the relationship.
      */
      allow delete: if signedIn()
        && (
          resource.data.followerId
            == request.auth.uid
          ||
          resource.data.followingId
            == request.auth.uid
        );
    }

    match /reflectionLikes/{likeId} {
      /*
      * Likes may only be read when the associated
      * reflection is public.
      *
      * This lets Community display Like counts while
      * preventing social interaction data from being
      * exposed for private reflections.
      */
      allow get, list: if signedIn();
      /*
      * Only the currently authenticated user can
      * create a Like in their own name.
      *
      * The user must:
      * - not be the post owner
      * - follow the post owner
      * - like an existing PUBLIC reflection
      */
      allow create: if signedIn()
        && request.resource.data.userId
          == request.auth.uid
        && request.resource.data.postOwnerId
          != request.auth.uid
        && request.resource.data.id
          == likeId
        && likeId ==
          request.resource.data.reflectionId
          + '_'
          + request.auth.uid
        && hasValidReflectionLikeShape(
          request.resource.data
        )
        && isPublicReflectionOwnedBy(
          request.resource.data.reflectionId,
          request.resource.data.postOwnerId
        )
        && followsPostOwner(
          request.auth.uid,
          request.resource.data.postOwnerId
        );

      /*
      * Likes should not be edited.
      * Unlike = delete the Like document.
      */
      allow update: if false;

      /*
      * The person who liked the reflection may unlike it.
      *
      * The post owner may also delete it so account/post
      * cleanup can remove interaction documents later.
      */
      allow delete: if signedIn()
        && (
          resource.data.userId
            == request.auth.uid
          || resource.data.postOwnerId
            == request.auth.uid
        );
    }

    match /reflectionComments/{commentId} {
      /*
      * Comments may only be read when their associated
      * reflection is public.
      */
      allow get, list: if signedIn();

      /*
      * Only the currently authenticated user can
      * create a comment in their own name.
      *
      * They must follow the reflection owner.
      */
      allow create: if signedIn()

      /*
      * Nobody may submit a comment/reply
      * pretending to be another user.
      */
      && request.resource.data.userId
        == request.auth.uid

      && request.resource.data.id
        == commentId

      && hasValidReflectionCommentShape(
        request.resource.data
      )

      /*
      * Absolutely no comments or replies
      * on private reflections.
      */
      && isPublicReflectionOwnedBy(
        request.resource.data.reflectionId,
        request.resource.data.postOwnerId
      )

      && (
        /*
        * NORMAL TOP-LEVEL COMMENT:
        *
        * must follow the post owner.
        */
        (
          !request.resource.data
            .keys()
            .hasAny([
              'parentCommentId',
              'replyToUserId'
            ])

          && request.resource.data
            .postOwnerId
            != request.auth.uid

          && followsPostOwner(
            request.auth.uid,
            request.resource.data.postOwnerId
          )
        )

        ||

        /*
        * REPLY:
        *
        * Any signed-in user may reply.
        * Following the post owner is NOT
        * required.
        */
        (
          request.resource.data
            .keys()
            .hasAll([
              'parentCommentId',
              'replyToUserId'
            ])

          && isValidReplyTarget(
            request.resource.data
          )
        )
      );

      /*
      * We have not implemented Edit Comment yet.
      */
      allow update: if false;

      /*
      * Comment author may delete their comment.
      * Reflection owner may also remove a comment.
      */
      allow delete: if signedIn()
        && (
          resource.data.userId
            == request.auth.uid
          || resource.data.postOwnerId
            == request.auth.uid
        );
    }

    match /notifications/{notificationId} {
      allow get, list: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || resource.data.actorUserId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.actorUserId == request.auth.uid
        && request.resource.data.userId != request.auth.uid
        && request.resource.data.id == notificationId
        && request.resource.data.readAt == null
        && hasValidSocialNotificationShape(
          request.resource.data
        )
        && (
          (
            request.resource.data.type == 'follow'
            && notificationId ==
              request.resource.data.actorUserId
              + '_'
              + request.resource.data.userId
              + '_'
              + request.resource.data.createdAt
            && createsMatchingFollow(
              request.resource.data
            )
          )

          ||

          (
            request.resource.data.type == 'like'
            && notificationId ==
              'like_'
              + request.resource.data.reflectionId
              + '_'
              + request.resource.data.actorUserId
              + '_'
              + request.resource.data.createdAt
            && isPublicReflectionOwnedBy(
              request.resource.data.reflectionId,
              request.resource.data.userId
            )
            && createsMatchingLikeNotification(
              request.resource.data
            )
          )

          ||

          (
            request.resource.data.type == 'comment'
            && notificationId ==
              'comment_'
              + request.resource.data.commentId
            && isPublicReflectionOwnedBy(
              request.resource.data.reflectionId,
              request.resource.data.userId
            )
            && createsMatchingCommentNotification(
              request.resource.data
            )
          )

          ||

          /*
          * REPLY
          */
          (
            request.resource.data.type
              == 'reply'

            && notificationId ==
              'reply_'
              + request.resource.data.commentId

            && createsMatchingReplyNotification(
              request.resource.data
            )
          )
        );

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'readAt'
          ])
        && request.resource.data.readAt != null
        && isIsoDate(
          request.resource.data.readAt
        )
        && hasValidSocialNotificationShape(
          request.resource.data
        );

      allow delete: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || resource.data.actorUserId == request.auth.uid
        );
    }

    function hasValidReflectionMedia(media, userId, reflectionId) {
      return media is map
        && media.keys().hasOnly(['path', 'type'])
        && media.keys().hasAll(['path', 'type'])
        && media.type in ['image', 'video']
        && media.path is string
        && media.path.matches('^users/' + userId + '/reflections/' + reflectionId + '/[A-Za-z0-9_-]+\\.(jpg|png|webp|mp4|webm|mov)$');
    }

    match /systemNotifications/{notificationId} {
      allow get, list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, delete: if false;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt is timestamp;
    }

    /*
    * This is NOT inside notifications.
    * This denies access to any collection
    * that does not have its own rule above.
    */
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
