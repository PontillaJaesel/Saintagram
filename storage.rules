rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isOwner(userId) {
      return signedIn()
        && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.admin == true;
    }

    function profileIsPrivate(userId) {
      let profilePath =
        /databases/(default)/documents/socialProfiles/$(userId);

      return firestore.exists(profilePath)
        && firestore.get(profilePath).data.get('isPrivateAccount', false) == true;
    }

    function followsUser(userId) {
      let followId =
        request.auth.uid + '_' + userId;

      let followPath =
        /databases/(default)/documents/follows/$(followId);

      return signedIn()
        && request.auth.uid != userId
        && firestore.exists(followPath)
        && firestore.get(followPath).data.followerId == request.auth.uid
        && firestore.get(followPath).data.followingId == userId;
    }

    function reflectionIsPublic(userId, reflectionId) {
      let reflectionPath =
        /databases/(default)/documents/reflectionPosts/$(reflectionId);

      return firestore.exists(reflectionPath)
        && firestore.get(reflectionPath).data.get('userId', '') == userId
        && firestore.get(reflectionPath).data.get('isPrivate', true) == false;
    }

    function canReadReflectionMedia(userId, reflectionId) {
      return isOwner(userId)
        || isAdmin()
        || (
          signedIn()
          && reflectionIsPublic(userId, reflectionId)
          && (
            !profileIsPrivate(userId)
            || followsUser(userId)
          )
        );
    }

    match /users/{userId}/profile/{imageName} {
      // Private accounts are still searchable, so their profile image stays visible.
      allow read: if signedIn();

      allow create: if isOwner(userId)
        && imageName.matches('^[A-Za-z0-9_-]+\\.(jpg|png|webp)$')
        && request.resource.size < 2097152
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if isOwner(userId);
      allow update: if false;
    }

    match /users/{userId}/cover/{imageName} {
      allow read: if signedIn();

      allow create: if isOwner(userId)
        && imageName.matches('^[A-Za-z0-9_-]+\\.(jpg|png|webp)$')
        && request.resource.size < 5242880
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if isOwner(userId);
      allow update: if false;
    }

    match /users/{userId}/reflections/{reflectionId}/{mediaName} {
      // Owner/admin can read immediately. Other users must be allowed to see
      // the reflection and, for private accounts, be an accepted follower.
      allow read: if canReadReflectionMedia(userId, reflectionId);

      allow create: if isOwner(userId)
        && request.resource.metadata.visibility in ['public', 'private']
        && mediaName.matches('^[A-Za-z0-9_-]+\\.(jpg|png|webp|mp4|webm|mov)$')
        && (
          (
            request.resource.size < 10485760
            && request.resource.contentType.matches('image/(jpeg|png|webp)')
          )
          || (
            request.resource.size < 52428800
            && request.resource.contentType.matches('video/(mp4|webm|quicktime)')
          )
        );

      allow delete: if isOwner(userId);
      allow update: if false;
    }
    match /bulletins/{adminId}/{imageName} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.auth.uid == adminId
        && imageName.matches('^[A-Za-z0-9_-]+\\.(jpg|png|webp)$')
        && request.resource.size < 5242880
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin() && request.auth.uid == adminId;
      allow update: if false;
    }
  }
}
