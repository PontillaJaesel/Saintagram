rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.uid == userId;
    }

    match /users/{userId}/profile/{imageName} {
      // Any signed-in Saintagram user may VIEW profile images.
      allow read: if request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.firebase.sign_in_provider == 'password';

      // Only the owner may UPLOAD.
      allow create: if isOwner(userId)
        && imageName.matches('^[A-Za-z0-9_-]+\\.(jpg|png|webp)$')
        && request.resource.size < 2097152
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      // Only the owner may DELETE.
      allow delete: if isOwner(userId);

      // Existing image objects cannot be overwritten.
      allow update: if false;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /users/{userId}/reflections/{reflectionId}/{mediaName} {
      allow read: if request.auth != null
        && (
          request.auth.uid == userId
          || isAdmin()
          || resource.metadata.visibility == 'public'
        );

      allow create: if isOwner(userId)
        && request.resource.metadata.visibility in ['public', 'private']
        && mediaName.matches('^[A-Za-z0-9_-]+\\.(jpg|png|webp|mp4|webm|mov)$')
        && (
          (
            request.resource.size < 10485760
            && request.resource.contentType.matches('image/(jpeg|png|webp)')
          )
          || (
            request.resource.size < 52428800
            && request.resource.contentType.matches('video/(mp4|webm|quicktime)')
          )
        );

      allow delete: if isOwner(userId);
      allow update: if false;
    }
  }
}
