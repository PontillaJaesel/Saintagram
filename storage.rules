rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function ownsPath(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isValidProfileImage() {
      return request.resource != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.metadata.ownerId == request.auth.uid;
    }

    // Storage Rules permit direct object access only to the authenticated owner.
    match /users/{userId}/profile/{fileName} {
      allow read: if ownsPath(userId);
      allow create, update: if ownsPath(userId) && isValidProfileImage();
      allow delete: if ownsPath(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
