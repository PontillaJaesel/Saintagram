# Saintagram automatically uses safe, device-local demo storage if these are blank.
# Firebase web config is not a secret; never place Admin SDK/service-account keys here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin credentials let the app verify a signed-in user
# and automatically grant the Supabase `authenticated` claim. Get these values
# from Firebase Console > Project settings > Service accounts. Never prefix
# them with NEXT_PUBLIC_ and never commit the real values.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Browser-safe Supabase connection used only for the private profile-images bucket.
# Configure Firebase as a Supabase Third-Party Auth provider. Never expose a
# Supabase secret or service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
