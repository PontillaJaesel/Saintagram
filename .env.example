# Server-only entrance gate. Use a 12+ character code and a separate random
# signing secret of at least 32 characters. Never prefix either key with
# NEXT_PUBLIC_ and never commit their real values.
SITE_ACCESS_CODE=
SITE_ACCESS_SESSION_SECRET=

# Saintagram automatically uses safe, device-local demo storage if these are blank.
# Firebase web config is not a secret; never place Admin SDK/service-account keys here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin credentials are used by server account-management
# operations. Never prefix them with NEXT_PUBLIC_ and never commit real values.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Browser-safe Supabase connection used only for the private profile-images bucket.
# Configure Firebase as a Supabase Third-Party Auth provider. Never expose a
# Supabase secret or service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
