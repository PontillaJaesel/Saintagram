{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.child('id').val() === $uid && newData.child('email').isString())"
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.child('id').val() === $uid && newData.child('userId').val() === $uid && !newData.hasChild('hiddenStory'))"
      }
    },
    "privateProfiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || newData.child('userId').val() === $uid"
      }
    },
    "drafts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.child('id').val() === $uid && newData.child('userId').val() === $uid)"
      }
    },
    "reflectionPosts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$postId": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || (newData.child('id').val() === $postId && newData.child('userId').val() === $uid)"
        }
      }
    }
  }
}
