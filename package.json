{
  "name": "saintagram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run prepare:ffmpeg && next dev",
    "build": "npm run prepare:ffmpeg && node scripts/run-vinext-build.mjs && node scripts/prepare-sites.mjs && node scripts/validate-deployment-artifacts.mjs && node scripts/prepare-admin-deployment.mjs",
    "start": "vinext start",
    "lint": "vinext lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "npx firebase-tools emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:firebase-live": "node --env-file=.env.local scripts/verify-firebase-connectivity.mjs",
    "dev:vinext": "npm run prepare:ffmpeg && vinext dev --port 3001",
    "build:vinext": "npm run prepare:ffmpeg && node scripts/run-vinext-build.mjs && node scripts/validate-deployment-artifacts.mjs && node scripts/prepare-admin-deployment.mjs",
    "build:admin": "npm run build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "start:admin": "npm run build:admin && wrangler dev --config dist/server/wrangler.admin.json",
    "deploy": "npm run build && node scripts/validate-deployment-target.mjs dist/server/wrangler.json saintagram normal && vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:vinext": "npm run deploy",
    "deploy:admin": "npm run build:admin && node scripts/validate-deployment-target.mjs dist/server/wrangler.admin.json saintagram-admin admin && wrangler deploy --config dist/server/wrangler.admin.json",
    "admin:claim": "node --env-file=.env.production scripts/set-admin-claim.mjs",
    "migrate:required-follows": "node --env-file=.env.production scripts/backfill-required-follows.mjs",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg-assets.mjs",
    "auth:provision": "node --env-file=.env.local scripts/provision-temporary-accounts.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@types/pdfmake": "^0.2.11",
    "exceljs": "^4.4.0",
    "firebase": "^11.4.0",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdfmake": "^0.2.20",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vinext/cloudflare": "^1.0.0-beta.4",
    "@vitejs/plugin-rsc": "^0.5.32",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.0.0",
    "oxlint": "^1.76.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vinext": "^1.0.0-beta.4",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "protobufjs@7.6.5": true,
    "sharp@0.34.5": true,
    "workerd@1.20260730.1": true,
    "@firebase/util@1.12.1": true
  }
}
