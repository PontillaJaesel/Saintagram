{
  "name": "saintagram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "vinext build && node scripts/prepare-sites.mjs",
    "start": "vinext start",
    "lint": "vinext lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "npx firebase-tools emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "firebase": "^11.4.0",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-rsc": "^0.5.32",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.0.0",
    "oxlint": "^1.76.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vinext": "^1.0.0-beta.4",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
